# Everything a run produces stays on the computer that ran it.
outputs/
# Rebuilt any time: python -m research_tests.make_samples / iq_check --generate
inputs/samples/
inputs/iq/generated/

# The fictional test inputs ARE committed (scans, answer keys, writers.csv,
# task packet, expected box table, templates), so every clone tests the same
# files - check_setup compares their SHA-256.

# Session data: only the workbook (participant codes P1-P5, checked by the
# pre-commit hook) - never recordings, consent forms or anything identifying.
inputs/sessions/*
!inputs/sessions/
!inputs/sessions/*.xlsx
!inputs/sessions/README.md
*.mp3
*.mp4
*.m4a
*.wav
*.mov
*.avi
*.mkv
*.webm
*consent*
*Consent*
*recording*
*Recording*
# Download duplicates such as "file (2).pdf"
inputs/**/* (*)*
inputs/* (*)*

__pycache__/
