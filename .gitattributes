.githooks/* text eol=lf

# PaddleOCR model files: byte-exact on every PC (never line-ending converted).
Ocr_module/ocr_models/** binary

# Windows scripts: always Windows line endings, whatever each PC's git
# settings - a .bat with Unix line endings can break its goto labels.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
