#!/bin/sh
# Adds screenshots + a CHANGELOG.md entry when a commit changes the UI.
# See tools/changelog_screenshots.py. Never blocks the commit.
# Enable once per clone:  git config core.hooksPath .githooks

ROOT="$(git rev-parse --show-toplevel)"
if [ -x "$ROOT/Ocr_module/venv/Scripts/python.exe" ]; then
    PY="$ROOT/Ocr_module/venv/Scripts/python.exe"
elif [ -x "$ROOT/Ocr_module/venv/bin/python" ]; then
    PY="$ROOT/Ocr_module/venv/bin/python"
else
    echo "[changelog] Ocr_module/venv not found - skipping screenshots."
    exit 0
fi

# RESEARCH TESTS (removable) START - refuse session files that may identify a
# participant (research_tests/setup/check_sessions.py). Blocks the commit.
if [ -d "$ROOT/research_tests" ]; then
    (cd "$ROOT" && "$PY" -m research_tests.setup.check_sessions) || exit 1
fi
# RESEARCH TESTS (removable) END

"$PY" "$ROOT/tools/changelog_screenshots.py"
exit 0
