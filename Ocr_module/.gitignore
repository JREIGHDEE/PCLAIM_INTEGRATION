# Virtual environment
venv/

# Python
__pycache__/
*.pyc
*.pyo

# VS Code
.vscode/

# Environment variables
.env

# Generated files
uploads/
debug_cells/

# Logbook setups put away by "Set up a logbook" on this PC (local history).
# The setups in use - grid_templates/*.json - ARE committed, so every
# groupmate reads logbooks with the same setup.
grid_templates/archive/

# OCR benchmark output (generated) and test scans (potentially sensitive
# patient forms - never committed by default; add real files locally only)
benchmarks/results/
benchmarks/test_data/**/*.png
benchmarks/test_data/**/*.jpg
benchmarks/test_data/**/*.jpeg
benchmarks/test_data/**/*.pdf
!benchmarks/test_data/**/.gitkeep

# OS
Thumbs.db
.DS_Store
.secret_key
