# Copy this file to `.env` and adjust values as needed.
# Nothing here is a secret — this service has no credentials/API keys today.
# Any variable left unset falls back to the default in config.py.

# --- Server ---
OCR_HOST=127.0.0.1
OCR_PORT=5000
OCR_DEBUG=true

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
# Default covers VS Code Live Server's default port (5500).
OCR_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# --- Storage ---
# Leave unset to use ./uploads and ./uploads/grid_templates (relative to
# this project's folder, regardless of where you launch it from).
# OCR_UPLOAD_DIR=uploads
# OCR_TEMPLATES_DIR=uploads/grid_templates

# --- Uploads ---
OCR_MAX_UPLOAD_MB=20

# --- Template matching ---
OCR_TEMPLATE_MATCH_THRESHOLD=0.55

# --- Database (MariaDB/MySQL via XAMPP) ---
# Defaults below match XAMPP's out-of-the-box MySQL/MariaDB setup (root user,
# empty password). Override these (especially DB_PASSWORD) if your XAMPP
# install differs. Never commit a real password - use a local .env file,
# which is gitignored, not this example file.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pclaimassist_db
DB_USER=root
DB_PASSWORD=
DB_CONNECT_TIMEOUT=5
